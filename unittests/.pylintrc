[pylint]
# for the unittests disable some pylint warnings, e.g. we don't want to force devs to write docstrings for every test
disable =
    C0114,  # disable missing-module-docstring
    C0115,  # disable missing-class-docstring
    C0116,  # disable missing-function-docstring
    R0903,  # disable too-few-public-methods
    W0621,  # disable redefined-outer-name (this is for the use of pytest fixtures)
    R0801,  # disable duplicate-code (we prefer our test to be explicit rather than perfectly redundancy free)
    C0302,  # disable too-many-lines (test files tend to be large)
    W0212,  # disable protected-access (tests may need to access internals)
    C0415,  # disable import-outside-toplevel (tests use local imports inside methods)
    C0413,  # disable wrong-import-position (tests can have imports after class defs)
    W0404,  # disable reimported (tests may reimport the same name in different methods)
    C0411,  # disable wrong-import-order
    C0412,  # disable ungrouped-imports
    W1309,  # disable f-string-without-interpolation
[pylint."MESSAGES CONTROL"]
max-line-length = 150